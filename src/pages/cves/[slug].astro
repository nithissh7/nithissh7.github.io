---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../consts";

export async function getStaticPaths() {
  const cves = await getCollection("cves", ({ data }) => !data.draft);
  return cves.map((cve) => ({ params: { slug: cve.id }, props: { cve } }));
}

const { cve } = Astro.props;
const { Content } = await render(cve);

const facts = [
  ["Product", cve.data.affectedProduct],
  cve.data.vendor && ["Vendor", cve.data.vendor],
  ["Severity", cve.data.severity + (cve.data.cvssScore !== undefined ? ` · CVSS ${cve.data.cvssScore.toFixed(1)}` : "")],
  ["Status", cve.data.status],
  ["Published", formatDate(cve.data.pubDate, "medium")],
].filter(Boolean) as [string, string][];
---

<BaseLayout
  title={cve.data.cveId}
  description={cve.data.description}
  type="article"
  pubDate={cve.data.pubDate}
  image={`/cves/${cve.id}/og.png`}
>
  <article data-pagefind-body>
    <a href="/cves" data-back data-pagefind-ignore class="nav-link text-[14px]">← All CVEs</a>

    <header class="mt-8 mb-10">
      <p class="text-[14px] text-dim mb-4">{cve.data.cveId}</p>
      <h1 class="text-[22px] sm:text-[26px] font-bold leading-[1.35] tracking-tight text-balance">{cve.data.title}</h1>
    </header>

    <dl class="box divide-y divide-border mb-10 text-[14px]">
      {facts.map(([k, v]) => (
        <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] gap-4 px-4 py-2.5">
          <dt class="text-dim">{k}</dt>
          <dd class="text-strong">{v}</dd>
        </div>
      ))}
    </dl>

    <div class="prose">
      <Content />
    </div>

    {cve.data.references && cve.data.references.length > 0 && (
      <section class="mt-12" data-pagefind-ignore>
        <h2 class="section-title">References</h2>
        <ul class="space-y-2 text-[14px]">
          {cve.data.references.map((ref) => (
            <li>
              <a href={ref} target="_blank" rel="noopener noreferrer" class="link break-all">{ref}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
