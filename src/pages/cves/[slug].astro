---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../consts";

export async function getStaticPaths() {
  const cves = await getCollection("cves", ({ data }) => !data.draft);
  return cves.map((cve) => ({
    params: { slug: cve.id },
    props: { cve },
  }));
}

const { cve } = Astro.props;
const { Content } = await render(cve);

const facts = [
  { k: "product", v: cve.data.affectedProduct },
  cve.data.vendor && { k: "vendor", v: cve.data.vendor },
  { k: "severity", v: cve.data.severity.toLowerCase() },
  cve.data.cvssScore !== undefined && { k: "cvss", v: cve.data.cvssScore.toFixed(1) },
  { k: "status", v: cve.data.status.toLowerCase() },
  { k: "published", v: formatDate(cve.data.pubDate) },
].filter(Boolean) as { k: string; v: string }[];
---

<BaseLayout
  title={cve.data.cveId}
  description={cve.data.description}
  type="article"
  pubDate={cve.data.pubDate}
  image={`/cves/${cve.id}/og.png`}
>
  <article data-pagefind-body>
    <a href="/cves" data-back data-pagefind-ignore class="quiet text-[13px]">← cd ../cves</a>

    <header class="mt-8 mb-10">
      <p class="text-[13px] text-muted mb-3 tabular-nums">{cve.data.cveId}</p>
      <h1 class="text-[22px] sm:text-[26px] font-bold leading-[1.25] tracking-tight mb-4 text-balance">
        {cve.data.title}
      </h1>
      {!cve.data.title.toLowerCase().includes(cve.data.description.toLowerCase()) && (
        <p class="font-serif italic text-[17px] leading-relaxed text-ink-2 max-w-2xl">{cve.data.description}</p>
      )}
    </header>

    <dl class="mb-10 border-t border-line text-[13px]">
      {facts.map(({ k, v }) => (
        <div class="flex gap-6 py-2 border-b border-line">
          <dt class="w-24 shrink-0 text-muted">{k}</dt>
          <dd class="text-ink min-w-0">{v}</dd>
        </div>
      ))}
    </dl>

    {cve.data.references && cve.data.references.length > 0 && (
      <section class="mb-12">
        <h2 class="text-[13px] font-bold mb-3"><span class="text-muted font-normal">## </span>references</h2>
        <ul class="space-y-1.5 text-[13px]">
          {cve.data.references.map((ref) => (
            <li class="flex gap-3">
              <span class="text-muted" aria-hidden="true">→</span>
              <a href={ref} target="_blank" rel="noopener noreferrer" class="link text-ink-2 break-all">{ref}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="prose" data-article>
      <Content />
    </div>
  </article>
</BaseLayout>
