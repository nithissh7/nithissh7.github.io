---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../consts";
import { splitCveTitle, vulnClass } from "../../lib/cve";

export async function getStaticPaths() {
  const cves = await getCollection("cves", ({ data }) => !data.draft);
  return cves.map((cve) => ({ params: { slug: cve.id }, props: { cve } }));
}

const { cve } = Astro.props;
const { Content } = await render(cve);
const { vuln, product } = splitCveTitle(cve.data.title);

const klass = vulnClass(cve.data.title);
const strip = [
  { k: "CVE ID", v: cve.data.cveId },
  ...(klass ? [{ k: "Class", v: klass }] : []),
  { k: "Severity", v: cve.data.severity },
  { k: "CVSS", v: cve.data.cvssScore?.toFixed(1) ?? "—" },
  { k: "Published", v: formatDate(cve.data.pubDate, "medium") },
];
---

<BaseLayout
  title={`${cve.data.cveId}: ${vuln}`}
  description={`${cve.data.cveId} — ${cve.data.title}`}
  type="article"
  pubDate={cve.data.pubDate}
  image={`/cves/${cve.id}/og.png`}
>
  <article>
    <header class="band">
      <nav aria-label="Breadcrumb" class="text-[13px] text-dim mb-8" data-pagefind-ignore>
        <a href="/cves/" class="nav-link">CVEs</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>{cve.data.cveId}</span>
      </nav>
      <h1 class="h-page max-w-[30ch] mb-4">{vuln}</h1>
      {product && <p class="lede mb-10">{product}{cve.data.vendor && <span class="text-dim"> · {cve.data.vendor}</span>}</p>}

      <dl class={`cells grid-cols-2 ${strip.length === 5 ? "md:grid-cols-5" : "md:grid-cols-4"} text-[14px]`} data-pagefind-ignore>
        {strip.map(({ k, v }) => (
          <div class="px-5 py-4">
            <dt class="text-[12px] text-dim mb-1">{k}</dt>
            <dd class="text-strong tabular-nums">{v}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="band">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
        <div class="prose" data-pagefind-body data-pagefind-meta={`title:${cve.data.cveId} · ${vuln}${product ? ` — ${product}` : ""}`}>
          {klass && <span class="sr-only">{klass} vulnerability in {product}.</span>}
          <Content />
        </div>
        {cve.data.references && cve.data.references.length > 0 && (
          <aside class="mt-12 lg:mt-0" data-pagefind-ignore>
            <div class="lg:sticky lg:top-24">
              <p class="text-[13px] text-strong font-bold mb-3">References</p>
              <ul class="space-y-2.5 text-[13px]">
                {cve.data.references.map((ref) => (
                  <li>
                    <a href={ref} target="_blank" rel="noopener noreferrer" class="link break-all">
                      {ref.replace(/^https?:\/\/(www\.)?/, "")}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="text-[13px] text-dim mt-8">Status: <span class="text-strong">{cve.data.status}</span></p>
            </div>
          </aside>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
