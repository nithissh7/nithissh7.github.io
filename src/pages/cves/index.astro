---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, yearOf } from "../../consts";
import { splitCveTitle, vulnClass } from "../../lib/cve";

const cves = (await getCollection("cves", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || (b.data.cvssScore ?? 0) - (a.data.cvssScore ?? 0)
);
const count = (sev: string) => cves.filter((c) => c.data.severity === sev).length;
const years = [...new Set(cves.map((c) => yearOf(c.data.pubDate)))].sort();
const stats = [
  { n: cves.length, label: "published" },
  { n: count("Critical") + count("High"), label: "high or critical" },
  { n: count("Medium"), label: "medium" },
  { n: years.length > 1 ? `${years[0]}–${years.at(-1)}` : years[0] ?? "—", label: "disclosed" },
];
const cols = "md:grid md:grid-cols-[10.5rem_minmax(0,1fr)_6rem_4rem_7.5rem] md:gap-6";
---

<BaseLayout title="CVEs" description="Security vulnerabilities discovered and responsibly disclosed by Nithissh.">
  <section class="band">
    <div class="max-w-3xl">
      <div>
        <div class="page-icon" aria-hidden="true">🐞</div>
        <span class="eyebrow">Disclosures</span>
        <h1 class="h-page mb-5">CVEs</h1>
        <p class="lede">Vulnerabilities I've found and responsibly disclosed. Each entry links to its NVD and CVE.org records.</p>
      </div>
      <ul class="flex flex-wrap gap-x-10 gap-y-3 mt-8 text-[14px]">
        {stats.map((s) => (
          <li class="flex items-baseline gap-2">
            <span class="text-strong font-bold text-[20px] tabular-nums">{s.n}</span>
            <span class="text-dim">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band !pt-2">
    {cves.length === 0 ? (
      <p>No CVEs published yet.</p>
    ) : (
      <div class="tlist">
        <div class={`table-head hidden ${cols} py-2.5 px-3 -mx-3`} aria-hidden="true">
          <span>ID</span><span>Vulnerability</span><span>Severity</span><span class="text-right">CVSS</span><span class="text-right">Published</span>
        </div>
        <ul>
          {cves.map((cve) => {
            const { vuln, product } = splitCveTitle(cve.data.title);
            const klass = vulnClass(cve.data.title);
            const high = cve.data.severity === "High" || cve.data.severity === "Critical";
            return (
              <li>
                <a href={`/cves/${cve.id}/`} class={`trow block ${cols} py-4 px-3 -mx-3 rounded-sm`}>
                  <span class="block text-[14px] text-strong tabular-nums md:pt-px">{cve.data.cveId}</span>
                  <span class="block min-w-0 mt-1 md:mt-0">
                    <span class="row-title block leading-snug">{vuln}</span>
                    <span class="flex flex-wrap items-center gap-2 text-[14px] text-dim mt-1.5">{klass && <span class="text-strong/80">{klass}</span>}{klass && <span aria-hidden="true">·</span>}{product}</span>
                  </span>
                  <span class="inline md:block text-[14px] md:pt-px">
                    <span class={high ? "text-strong font-bold" : "text-dim"}>{cve.data.severity}</span>
                  </span>
                  <span class="inline md:block text-[14px] text-dim tabular-nums md:text-right md:pt-px">
                    <span class="md:hidden"> · CVSS </span>{cve.data.cvssScore?.toFixed(1) ?? "—"}
                  </span>
                  <span class="block md:text-right text-[13px] md:text-[14px] text-dim tabular-nums mt-1 md:mt-0 md:pt-px">
                    {formatDate(cve.data.pubDate, "medium")}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>
