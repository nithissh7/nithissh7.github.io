---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeverityBar from "../../components/SeverityBar.astro";
import { formatDate, yearOf } from "../../consts";
import { getCves } from "../../lib/posts";
import { severityKey, splitCveTitle, vulnClass } from "../../lib/cve";

const cves = await getCves();
const years = [...new Set(cves.map((c) => yearOf(c.data.pubDate)))]; // newest first
const span = years.length > 1 ? `${years.at(-1)}–${years[0]}` : `${years[0] ?? ""}`;
// Class filter: every class present, plus "Other" for unclassified entries.
const classCounts = new Map<string, number>();
for (const c of cves) {
  const k = vulnClass(c.data.title) ?? "Other";
  classCounts.set(k, (classCounts.get(k) ?? 0) + 1);
}
const classes = [...classCounts].sort((a, b) => (a[0] === "Other" ? 1 : b[0] === "Other" ? -1 : b[1] - a[1]));
---

<BaseLayout title="CVEs" description="Security vulnerabilities discovered and responsibly disclosed by Nithissh.">
  <div class="shell">
    <header class="page-head">
      <h1 class="h-page">CVEs</h1>
      <p class="lede mt-5">Vulnerabilities I've found and responsibly disclosed, newest first. Each entry links to its NVD and CVE.org records.</p>
    </header>

    {cves.length === 0 ? (
      <p class="text-dim">No CVEs published yet.</p>
    ) : (
      <>
        <section class="grid gap-x-16 gap-y-5 md:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] md:items-end mb-10" aria-label="Summary">
          <SeverityBar cves={cves} />
          <p class="meta md:justify-end"><span>{cves.length} published</span><span>{span}</span></p>
        </section>

        <div class="filter-chips mb-8" role="group" aria-label="Filter by vulnerability class" data-cve-filter>
          <button type="button" class="tag cursor-pointer" aria-pressed="true" data-filter="all">All <span class="n">{cves.length}</span></button>
          {classes.map(([k, n]) => (
            <button type="button" class="tag cursor-pointer" aria-pressed="false" data-filter={k}>
              {k} <span class="n">{n}</span>
            </button>
          ))}
        </div>

        <div class="table-head cve-cols hidden md:grid pb-2.5" aria-hidden="true">
          <span>ID</span><span>Vulnerability</span><span>Severity</span><span class="right">CVSS</span><span class="right">Published</span>
        </div>
        {years.map((year) => {
          const inYear = cves.filter((c) => yearOf(c.data.pubDate) === year);
          return (
            <section class="year-group" data-year-group>
              <h2 class="year-head">{year}<span class="n" data-year-count>{inYear.length}</span></h2>
              <ul>
                {inYear.map((cve) => {
                  const { vuln, product } = splitCveTitle(cve.data.title);
                  return (
                    <li data-class={vulnClass(cve.data.title) ?? "Other"}>
                      <a href={`/cves/${cve.id}/`} class="cve-row cve-cols">
                        <span class="cve-id">{cve.data.cveId}</span>
                        <span class="cve-main">
                          <span class="row-title">{vuln}</span>
                          {product && <span class="cve-product">{product}</span>}
                        </span>
                        <span class="cve-sev"><span class="sev" data-sev={severityKey(cve.data.severity)}>{cve.data.severity}</span></span>
                        <span class="cve-num cve-score">{cve.data.cvssScore?.toFixed(1) ?? "—"}</span>
                        <span class="cve-num cve-date">{formatDate(cve.data.pubDate, "day")}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })}
      </>
    )}
  </div>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const group = document.querySelector<HTMLElement>("[data-cve-filter]");
    if (!group || group.dataset.ready) return;
    group.dataset.ready = "true";
    group.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!btn) return;
      const f = btn.dataset.filter!;
      group.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      document.querySelectorAll<HTMLElement>("[data-year-group]").forEach((section) => {
        let inYear = 0;
        section.querySelectorAll<HTMLElement>("li[data-class]").forEach((li) => {
          li.hidden = f !== "all" && li.dataset.class !== f;
          if (!li.hidden) inYear++;
        });
        section.hidden = inYear === 0;
        const count = section.querySelector("[data-year-count]");
        if (count) count.textContent = String(inYear);
      });
    });
  });
</script>
