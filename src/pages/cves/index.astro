---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../consts";

const cves = (await getCollection("cves", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || (b.data.cvssScore ?? 0) - (a.data.cvssScore ?? 0)
);
const severities = ["Critical", "High", "Medium", "Low", "Informational"] as const;
const breakdown = severities
  .map((sev) => ({ sev, n: cves.filter((c) => c.data.severity === sev).length }))
  .filter((s) => s.n > 0)
  .map((s) => `${s.n} ${s.sev.toLowerCase()}`)
  .join(", ");
---

<BaseLayout title="CVEs" description="Security vulnerabilities discovered and responsibly disclosed by Nithissh.">
  <h1 class="text-[22px] font-bold leading-snug mb-4">CVEs</h1>
  <p class="mb-14">
    Vulnerabilities I've found and responsibly disclosed.
    {cves.length > 0 && <>{cves.length} so far: {breakdown}.</>}
  </p>

  {cves.length === 0 ? (
    <p>No CVEs published yet.</p>
  ) : (
    <ul class="-my-3">
      {cves.map((cve) => (
        <li>
          <a href={`/cves/${cve.id}/`} class="entry">
            <div class="min-w-0">
              <p class="entry-title">{cve.data.title}</p>
              <p class="entry-desc">
                {cve.data.cveId} · {cve.data.severity.toLowerCase()}
                {cve.data.cvssScore !== undefined && ` ${cve.data.cvssScore.toFixed(1)}`}
              </p>
            </div>
            <time class="entry-date" datetime={cve.data.pubDate.toISOString()}>{formatDate(cve.data.pubDate, "medium")}</time>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
