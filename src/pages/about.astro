---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import { SOCIAL_LINKS } from "../consts";
import { getCves, getPosts } from "../lib/posts";

const posts = await getPosts();
const cveCount = (await getCves()).length;
const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const monthYear = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "Asia/Kolkata" });
const external = (href: string) => href.startsWith("http");

const areas = [
  { k: "Offense", v: "Bug bounty, web and API pentesting, cloud security (AWS, Azure, GCP), vulnerability research." },
  { k: "Defense", v: "Platform and AI security, SOC operations, SIEM and EDR, DevSecOps, incident response." },
  { k: "Build", v: "Security tooling, automation, open source contributions, and this blog." },
];
---

<BaseLayout title="About" description="Security architect by day, bug bounty hunter by night.">
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1 class="h-page max-w-[22ch]">I break things to understand <em>how to defend them.</em></h1>
      <p class="lede mt-5">Security architect by day, bug bounty hunter by night.</p>
    </header>

    <div class="grid gap-y-12 lg:grid-cols-[minmax(0,1fr)_20.5rem] lg:gap-x-[4.5rem]">
      <div>
        <div class="prose max-w-[40rem]">
          <p>
            I'm Nithissh. I handle platform and AI security at one of the largest pharma companies. Outside work I
            hunt vulnerabilities — <a href="/cves/">{cveCount} of them are now CVEs</a> — write security tools, and
            document what I learn here.
          </p>
          <p>
            The thing that keeps me going is curiosity — there's nothing quite like finding the flaw that nobody else
            noticed.
          </p>
          <p>
            I write to think. Bug bounty write-ups, cloud security research, CTF solutions, SOC notes — whatever I'm into
            that week ends up here. Mostly for future me, so I don't relearn things twice. If it helps you too, that's a
            bonus.
          </p>
        </div>

        {featured.length > 0 && (
          <section class="mt-12" aria-labelledby="start-here">
            <div class="section-head">
              <h2 id="start-here" class="h-section">Start here</h2>
              <a href="/blog/" class="more-link">All {posts.length} posts →</a>
            </div>
            <EntryList posts={featured} compact />
          </section>
        )}
      </div>

      <aside class="grid gap-12 content-start">
        <section aria-labelledby="what-i-do">
          <div class="section-head">
            <h2 id="what-i-do" class="h-section">What I do</h2>
          </div>
          <dl class="facts">
            {areas.map((a) => (
              <div>
                <dt>{a.k}</dt>
                <dd>{a.v}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section aria-labelledby="elsewhere">
          <div class="section-head">
            <h2 id="elsewhere" class="h-section">Elsewhere</h2>
          </div>
          <ul class="elsewhere !mt-4">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link"
                  target={external(link.href) ? "_blank" : undefined}
                  rel={external(link.href) ? "noopener noreferrer me" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>

    <section class="mt-16" aria-labelledby="certifications">
      <div class="section-head">
        <h2 id="certifications" class="h-section">Certifications<span class="n">{certs.length}</span></h2>
        <a href="/certifications/" class="more-link">Details →</a>
      </div>
      <ul class="grid md:grid-cols-2 md:gap-x-16">
        {certs.map((cert) => (
          <li class="cert !grid-cols-[2.75rem_minmax(0,1fr)]">
            {cert.data.badgeUrl ? <img src={cert.data.badgeUrl} alt="" width="44" height="44" loading="lazy" /> : <span />}
            <div class="min-w-0">
              <span class="cert-name">{cert.data.name}</span>
              <span class="meta mt-1"><span>{cert.data.issuer}</span><span>{monthYear(cert.data.dateEarned)}</span></span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
