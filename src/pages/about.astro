---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);

const areas = [
  ["Offense", "Bug bounty, web and API pentesting, cloud security (AWS, Azure, GCP), vulnerability research."],
  ["Defense", "Platform and AI security, SOC operations, SIEM and EDR, DevSecOps, incident response."],
  ["Build", "Security tooling, automation, open source contributions, and this blog."],
];
---

<BaseLayout title="About" description="Security architect by day, bug bounty hunter by night.">
  <h1 class="text-[22px] font-bold leading-snug mb-8">About</h1>

  <div class="prose mb-16">
    <p>
      I'm Nithissh — a security architect by day and a bug bounty hunter by night. I break things to understand
      how to defend them better.
    </p>
    <p>
      I handle platform and AI security at one of the largest pharma companies. Outside work I hunt
      vulnerabilities, write security tools, and document what I learn here.
    </p>
    <p>
      I write to think. Mostly for future me, so I don't relearn things twice. If it helps you too, that's a
      bonus.
    </p>
  </div>

  <section class="mb-16">
    <h2 class="section-title">What I do</h2>
    <dl class="space-y-4">
      {areas.map(([k, v]) => (
        <div class="grid sm:grid-cols-[7rem_minmax(0,1fr)] gap-x-4">
          <dt class="text-strong font-medium">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mb-16">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 class="section-title !mb-0">Certifications</h2>
      <a href="/certifications" class="nav-link text-[14px]">details →</a>
    </div>
    <ul class="space-y-2">
      {certs.map((cert) => (
        <li class="flex justify-between gap-6">
          <span class="text-strong">{cert.data.name}</span>
          <span class="text-dim text-[14px] shrink-0">{cert.data.issuer}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="section-title">Elsewhere</h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="link"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
