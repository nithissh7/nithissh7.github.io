---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);

const areas = [
  { k: "offense", v: "Bug bounty · web and API pentesting · cloud security (AWS, Azure, GCP) · vulnerability research" },
  { k: "defense", v: "Platform and AI security · SOC operations · SIEM and EDR · DevSecOps · incident response" },
  { k: "build", v: "Security tooling · automation · open source contributions · this blog" },
];
---

<BaseLayout title="About" description="Security architect by day, bug bounty hunter by night.">
  <p class="text-[13px] text-muted mb-3" aria-hidden="true">$ cat about.md</p>
  <h1 class="text-[22px] font-bold mb-8">About</h1>

  <div class="prose mb-14">
    <p>
      Security architect by day, bug bounty hunter by night — I break things to understand how to defend them
      better.
    </p>
    <p>
      I handle platform and AI security at one of the largest pharma companies. Outside work, I spend my time
      hunting vulnerabilities, writing security tools, and documenting everything I learn on this blog.
    </p>
    <p>The thing that keeps me going is curiosity — there's nothing quite like finding the flaw that nobody else noticed.</p>
  </div>

  <section class="mb-14">
    <h2 class="rule text-[13px] mb-1">what i do</h2>
    <dl class="text-[13px]">
      {areas.map(({ k, v }) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6 py-3 border-b border-line">
          <dt class="sm:w-24 shrink-0 text-ink font-bold">{k}</dt>
          <dd class="text-ink-2">{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mb-14">
    <h2 class="rule text-[13px] mb-1">certifications</h2>
    <ul class="text-[13px]">
      {certs.map((cert) => (
        <li class="flex justify-between gap-6 py-2.5 border-b border-line">
          <span class="text-ink">{cert.data.name}</span>
          <span class="text-muted shrink-0">{cert.data.issuer}</span>
        </li>
      ))}
    </ul>
    <a href="/certifications" class="quiet inline-block mt-4 text-[13px]">all certs with badges →</a>
  </section>

  <section class="mb-14">
    <h2 class="rule text-[13px] mb-4">this blog</h2>
    <div class="prose">
      <p>
        I write to think. Bug bounty write-ups, cloud security research, CTF solutions, SOC learning notes —
        whatever I'm into that week ends up here.
      </p>
      <p>Mostly for future-me, so I don't relearn things twice. If it helps you too, that's a bonus.</p>
    </div>
  </section>

  <section>
    <h2 class="rule text-[13px] mb-4">connect</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[13px]">
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="btn-bracket"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
