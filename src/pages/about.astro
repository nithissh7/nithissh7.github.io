---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";
const cveCount = (await getCollection("cves", ({ data }) => !data.draft)).length;

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);

const areas = [
  { k: "Offense", v: "Bug bounty, web and API pentesting, cloud security (AWS, Azure, GCP), vulnerability research." },
  { k: "Defense", v: "Platform and AI security, SOC operations, SIEM and EDR, DevSecOps, incident response." },
  { k: "Build", v: "Security tooling, automation, open source contributions, and this blog." },
];
---

<BaseLayout title="About" description="Security architect by day, bug bounty hunter by night.">
  <section class="band">
    <span class="eyebrow">About</span>
    <h1 class="h-page mb-5">I break things to understand how to defend them.</h1>
    <p class="lede">Security architect by day, bug bounty hunter by night.</p>
  </section>

  <section class="band">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7 prose">
        <p>
          I'm Nithissh. I handle platform and AI security at one of the largest pharma companies. Outside work I
          hunt vulnerabilities — <a href="/cves/">{cveCount} of them are now CVEs</a> — write security tools, and
          document what I learn here.
        </p>
        <p>
          The thing that keeps me going is curiosity — there's nothing quite like finding the flaw that nobody else
          noticed.
        </p>
        <p>
          I write to think. Bug bounty write-ups, cloud security research, CTF solutions, SOC notes — whatever I'm into
          that week ends up here. Mostly for future me, so I don't relearn things twice. If it helps you too, that's a
          bonus.
        </p>
      </div>
      <div class="lg:col-span-5 space-y-10">
        <div>
          <p class="text-[13px] text-strong font-bold mb-3">What I do</p>
          <dl class="space-y-5">
            {areas.map((a) => (
              <div>
                <dt class="text-strong font-medium mb-1">{a.k}</dt>
                <dd class="text-[14px] text-dim leading-relaxed">{a.v}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <p class="text-[13px] text-strong font-bold mb-3">Elsewhere</p>
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[14px]">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link"
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2 class="h-section">Certifications</h2>
      <a href="/certifications/" class="nav-link text-[14px]">Details →</a>
    </div>
    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-5 text-[14px]">
      {certs.map((c) => (
        <li>
          <span class="block text-strong">{c.data.name}</span>
          <span class="block text-[13px] text-dim">{c.data.issuer}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
