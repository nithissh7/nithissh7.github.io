---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search">
  <h1 class="text-[22px] font-bold leading-snug mb-8">Search</h1>
  <div id="search" class="pagefind-brutal"></div>
  <p
    id="search-unavailable"
    class="hidden box p-5 text-[14px]"
  >
    Search index isn't available in <code>astro dev</code>. Pagefind only builds its
    index as part of <code>npm run build</code> — run that (or <code>npm run preview</code>
    after building) to try search locally.
  </p>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("search");
    const fallback = document.getElementById("search-unavailable");
    if (el && typeof PagefindUI === "function" && !el.dataset.initialized) {
      el.dataset.initialized = "true";
      new PagefindUI({ element: "#search", showSubResults: false, showImages: false, autofocus: true });
    } else if (el && typeof PagefindUI !== "function") {
      el.classList.add("hidden");
      fallback?.classList.remove("hidden");
    }
  });
</script>

<style is:global>
  .pagefind-brutal {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--strong);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--bg-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: "JetBrains Mono", ui-monospace, monospace;
  }
  .pagefind-brutal .pagefind-ui__result-link {
    color: var(--strong);
  }
  .pagefind-brutal .pagefind-ui__result-excerpt {
    color: var(--dim);
  }
  .pagefind-brutal .pagefind-ui mark {
    background: transparent;
    color: var(--strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
