---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const suggestions = [...counts].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([t]) => t);
---

<BaseLayout title="Search" description="Search every post and CVE on realnits.">
  <section class="band">
    <span class="eyebrow">Search</span>
    <h1 class="h-page mb-8">Find a post or CVE</h1>
    <form role="search" class="relative max-w-3xl" onsubmit="return false">
      <label for="search-input" class="sr-only">Search posts and CVEs</label>
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-dim pointer-events-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="xss, gemini, sql injection…"
        class="w-full h-14 pl-12 pr-4 rounded-lg border border-border-strong bg-bg text-strong text-[16px] placeholder:text-dim outline-none focus:border-strong transition-colors"
      />
    </form>
    <div class="flex flex-wrap items-center gap-2 mt-5 text-[13px]" id="search-suggestions">
      <span class="text-dim mr-1">Try:</span>
      {suggestions.map((s) => <button type="button" class="tag !text-[13px] cursor-pointer hover:text-strong hover:border-border-strong" data-suggest={s}>{s}</button>)}
    </div>
  </section>

  <section class="band !pt-6 lg:!pt-8 min-h-[40vh]">
    <p id="search-status" class="text-[13px] text-dim mb-4" aria-live="polite">Start typing to search {posts.length} posts and every CVE.</p>
    <ul id="search-results" class="tlist hidden"></ul>
  </section>
</BaseLayout>

<script>
  type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
  type Pagefind = { init: () => Promise<void>; debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: PagefindResult[] } | null> };

  let pagefind: Pagefind | null = null;
  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      const url = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
      await pagefind.init();
    } catch {
      pagefind = null;
    }
    return pagefind;
  }

  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  function setup() {
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const list = document.getElementById("search-results");
    const status = document.getElementById("search-status");
    if (!input || !list || !status || input.dataset.ready) return;
    input.dataset.ready = "true";
    const idle = status.textContent ?? "";

    async function run(q: string) {
      const url = new URL(location.href);
      q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
      history.replaceState(history.state, "", url);

      if (!q.trim()) {
        list!.classList.add("hidden");
        list!.innerHTML = "";
        status!.textContent = idle;
        return;
      }
      const pf = await load();
      if (!pf) {
        status!.textContent = "Search index isn't available here. It's generated by `npm run build`.";
        return;
      }
      const search = await pf.debouncedSearch(q, {}, 120);
      if (!search) return; // superseded by a newer keystroke
      const data = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      status!.textContent = data.length
        ? `${search.results.length} result${search.results.length === 1 ? "" : "s"} for “${q}”`
        : `No results for “${q}”. Try a broader term.`;
      list!.classList.toggle("hidden", data.length === 0);
      list!.innerHTML = data
        .map((d) => {
          const kind = d.url.startsWith("/cves/") ? "CVE" : "Post";
          return `<li><a href="${escape(d.url)}" class="trow block md:grid md:grid-cols-[4.5rem_minmax(0,1fr)] md:gap-6 py-5 px-3 -mx-3 rounded-sm">
            <span class="block text-[12px] text-dim md:pt-1">${kind}</span>
            <span class="block min-w-0">
              <span class="row-title block leading-snug">${escape(d.meta.title ?? d.url)}</span>
              <span class="search-excerpt block text-[14px] text-dim mt-1.5 leading-relaxed">${d.excerpt}</span>
            </span>
          </a></li>`;
        })
        .join("");
    }

    input.addEventListener("input", () => run(input.value));
    document.getElementById("search-suggestions")?.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-suggest]");
      if (!b) return;
      input.value = b.dataset.suggest!;
      input.focus();
      run(input.value);
    });

    const initial = new URL(location.href).searchParams.get("q");
    if (initial) {
      input.value = initial;
      run(initial);
    }
    input.focus();
    load();
  }

  document.addEventListener("astro:page-load", setup);
</script>

<style is:global>
  .search-excerpt mark {
    background: transparent;
    color: var(--strong);
    font-weight: 500;
  }
</style>
