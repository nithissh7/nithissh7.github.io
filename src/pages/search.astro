---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search">
  <p class="text-[13px] text-muted mb-3" aria-hidden="true">$ grep -ri</p>
  <h1 class="text-[22px] font-bold mb-8">Search</h1>
  <div id="search" class="pagefind-brutal"></div>
  <p
    id="search-unavailable"
    class="hidden border border-line rounded-[4px] p-5 text-[13px] text-ink-2"
  >
    Search index isn't available in <code>astro dev</code>. Pagefind only builds its
    index as part of <code>npm run build</code> — run that (or <code>npm run preview</code>
    after building) to try search locally.
  </p>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("search");
    const fallback = document.getElementById("search-unavailable");
    if (el && typeof PagefindUI === "function" && !el.dataset.initialized) {
      el.dataset.initialized = "true";
      new PagefindUI({ element: "#search", showSubResults: true, showImages: false, autofocus: true });
    } else if (el && typeof PagefindUI !== "function") {
      el.classList.add("hidden");
      fallback?.classList.remove("hidden");
    }
  });
</script>

<style is:global>
  .pagefind-brutal {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line-strong);
    --pagefind-ui-tag: var(--surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-font: "JetBrains Mono", ui-monospace, monospace;
  }
  .pagefind-brutal .pagefind-ui__result-excerpt {
    color: var(--ink-2);
  }
  .pagefind-brutal .pagefind-ui mark {
    background: var(--surface);
    color: var(--ink);
    box-shadow: inset 0 -0.4em 0 var(--line-strong);
  }
</style>
