---
import BaseLayout from "../layouts/BaseLayout.astro";
import Search from "../components/Search.astro";
---

<BaseLayout title="Search" description="Search every post and CVE on realnits.">
  <section class="band min-h-[70vh]">
    <div class="max-w-3xl">
      <span class="eyebrow">Search</span>
      <h1 class="h-page mb-8">Find a post or CVE</h1>
      <Search mode="page" />
    </div>
  </section>
</BaseLayout>
