---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);
const monthYear = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "Asia/Kolkata" });
---

<BaseLayout title="Certifications" description="Professional certifications and credentials earned by Nithissh.">
  <div class="shell">
    <header class="page-head">
      <nav aria-label="Breadcrumb" class="eyebrow">
        <a href="/about/">About</a>
        <span class="sep">/</span>
        <span>Credentials</span>
      </nav>
      <h1 class="h-page">Certifications</h1>
      <p class="lede mt-5">Hands-on certifications across web application security, cloud, and DevSecOps, newest first, each with a link to verify it.</p>
    </header>

    <ul class="border-t border-border-strong">
      {certs.map((cert) => (
        <li class="cert">
          {cert.data.badgeUrl ? <img src={cert.data.badgeUrl} alt="" width="44" height="44" loading="lazy" /> : <span />}
          <div class="min-w-0">
            <h2 class="cert-name">{cert.data.name}</h2>
            <p class="meta mt-1"><span>{cert.data.issuer}</span><span>{monthYear(cert.data.dateEarned)}</span></p>
          </div>
          {cert.data.credentialUrl && (
            <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="more-link" aria-label={`Verify ${cert.data.name}`}>
              Verify ↗
            </a>
          )}
          <p class="cert-desc">{cert.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
