---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);
const monthYear = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "Asia/Kolkata" });
---

<BaseLayout title="Certifications" description="Professional certifications and credentials earned by Nithissh.">
  <section class="band">
    <span class="eyebrow">Credentials · {certs.length}</span>
    <h1 class="h-page mb-5">Certifications</h1>
    <p class="lede">Hands-on certifications across web application security, cloud, and DevSecOps — newest first, each with a link to verify it.</p>
  </section>

  <section class="band">
    <ul class="cells md:grid-cols-2 lg:grid-cols-3 !gap-y-12">
      {certs.map((cert) => (
        <li class="flex flex-col">
          <div class="flex items-start gap-4 mb-4">
            {cert.data.badgeUrl && (
              <img
                src={cert.data.badgeUrl}
                alt=""
                width="48"
                height="48"
                loading="lazy"
                class="size-12 shrink-0 object-contain rounded-md bg-white p-1"
              />
            )}
            <div class="min-w-0">
              <h2 class="text-strong font-bold leading-snug">{cert.data.name}</h2>
              <p class="text-[13px] text-dim mt-1">{cert.data.issuer} · {monthYear(cert.data.dateEarned)}</p>
            </div>
          </div>
          <p class="text-[14px] leading-relaxed mb-5">{cert.data.description}</p>
          {cert.data.credentialUrl && (
            <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="link text-[14px] mt-auto">
              Verify credential ↗
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
