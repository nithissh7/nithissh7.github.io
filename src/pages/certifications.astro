---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const certs = (await getCollection("certifications")).sort(
  (a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf()
);
const year = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "Asia/Kolkata" });
---

<BaseLayout title="Certifications" description="Professional certifications and credentials earned by Nithissh.">
  <h1 class="text-[22px] font-bold leading-snug mb-4">Certifications</h1>
  <p class="mb-14">Credentials I've earned along the way, newest first.</p>

  {certs.length === 0 ? (
    <p>No certifications listed yet.</p>
  ) : (
    <ul class="space-y-10">
      {certs.map((cert) => (
        <li class="flex gap-5">
          {cert.data.badgeUrl && (
            <img
              src={cert.data.badgeUrl}
              alt=""
              width="52"
              height="52"
              loading="lazy"
              class="size-[52px] shrink-0 object-contain rounded-md bg-white p-1.5 border border-border"
            />
          )}
          <div class="min-w-0">
            <h2 class="font-bold leading-snug">{cert.data.name}</h2>
            <p class="text-[14px] text-dim mb-2">{cert.data.issuer} · {year(cert.data.dateEarned)}</p>
            <p class="text-[14px] leading-relaxed">{cert.data.description}</p>
            {cert.data.credentialUrl && (
              <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="link inline-block mt-2 text-[14px]">
                Verify credential ↗
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
