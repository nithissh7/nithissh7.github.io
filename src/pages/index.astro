---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import SeverityBar from "../components/SeverityBar.astro";
import { SITE_TAGLINE, SOCIAL_LINKS, tagLabel } from "../consts";
import { getCves, getPosts, tagCounts } from "../lib/posts";
import { severityKey, splitCveTitle } from "../lib/cve";

const posts = await getPosts();
const cves = await getCves();
// The home page carries the most recent posts in full; the archive has the rest.
const HOME_POSTS = 8;
const topics = tagCounts(posts).slice(0, 10);
const external = (href: string) => href.startsWith("http");
---

<BaseLayout>
  <div class="shell home">
    <div>
      <section class="home-intro">
        <h1 class="h-page">Security research, <em>written down.</em></h1>
        <p class="lede">{SITE_TAGLINE}</p>
        <ul class="elsewhere">
          {SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                target={external(link.href) ? "_blank" : undefined}
                rel={external(link.href) ? "noopener noreferrer me" : undefined}
              >
                {link.label}{external(link.href) && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="writing">
        <div class="section-head">
          <h2 id="writing" class="h-section">Writing<span class="n">{posts.length}</span></h2>
          <a href="/blog/" class="more-link">Archive →</a>
        </div>
        <EntryList posts={posts.slice(0, HOME_POSTS)} lead />
        {posts.length > HOME_POSTS && (
          <p class="mt-6"><a href="/blog/" class="more-link">{posts.length - HOME_POSTS} older posts in the archive →</a></p>
        )}
      </section>
    </div>

    <aside class="home-side">
      {cves.length > 0 && (
        <section aria-labelledby="disclosures">
          <div class="section-head">
            <h2 id="disclosures" class="h-section">CVEs disclosed<span class="n">{cves.length}</span></h2>
            <a href="/cves/" class="more-link">All →</a>
          </div>
          <div class="pt-5 pb-4">
            <SeverityBar cves={cves} />
          </div>
          <ul class="border-t border-border">
            {cves.slice(0, 5).map((cve) => {
              const { vuln, product } = splitCveTitle(cve.data.title);
              return (
                <li class="border-b border-border">
                  <a href={`/cves/${cve.id}/`} class="cve-mini">
                    <span class="cve-mini-top">
                      <span class="cve-id">{cve.data.cveId}</span>
                      <span class="sev" data-sev={severityKey(cve.data.severity)}>
                        {cve.data.severity}
                        {cve.data.cvssScore !== undefined && <span class="text-dim tabular-nums">{cve.data.cvssScore.toFixed(1)}</span>}
                      </span>
                    </span>
                    <span class="row-title">{vuln}</span>
                    {product && <span class="cve-product">{product}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {topics.length > 0 && (
        <section aria-labelledby="topics">
          <div class="section-head">
            <h2 id="topics" class="h-section">Topics</h2>
            <a href="/tags/" class="more-link">All →</a>
          </div>
          <ul class="flex flex-wrap gap-2 pt-5">
            {topics.map(([tag, n]) => (
              <li>
                <a href={`/tags/${tag}/`} class="tag">{tagLabel(tag)} <span class="n">{n}</span></a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>
