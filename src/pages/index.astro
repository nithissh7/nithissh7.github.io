---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_TAGLINE, formatDate, yearOf } from "../consts";
import { getReadingTime } from "../lib/reading-time";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const cves = await getCollection("cves", ({ data }) => !data.draft);
const certs = await getCollection("certifications");
const [latest, ...rest] = posts;
const firstYear = Math.min(...[...posts, ...cves].map((e) => yearOf(e.data.pubDate)));

const stats = [
  { n: posts.length, label: "posts", href: "/blog/" },
  { n: cves.length, label: "CVEs", href: "/cves/" },
  { n: certs.length, label: "certifications", href: "/certifications/" },
  { n: firstYear, label: "writing since", href: "/about/", before: true },
];

const explore = [
  { href: "/cves/", title: "CVEs", body: `${cves.length} vulnerabilities I've found and responsibly disclosed, with severity and CVSS.` },
  { href: "/certifications/", title: "Certifications", body: `${certs.length} credentials across web, cloud, and DevSecOps, each with a verification link.` },
  { href: "/about/", title: "About", body: "Who I am, what I work on during the day, and what I hunt at night." },
];
---

<BaseLayout>
  <section class="band !pt-14 lg:!pt-24">
    <div class="max-w-3xl">
      <div class="page-icon" aria-hidden="true">👋</div>
      <span class="eyebrow">Nithissh · security researcher</span>
      <h1 class="h-page mb-6">Security research, written down.</h1>
      <p class="lede mb-8">{SITE_TAGLINE}</p>
      <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3 mb-12">
        <a href="/blog/" class="btn">Read the blog →</a>
        <a href="/about/" class="btn btn-ghost">About me</a>
      </div>
      <ul class="flex flex-wrap gap-x-10 gap-y-4 text-[14px]">
        {stats.map((s) => (
          <li>
            <a href={s.href} class="group flex items-baseline gap-2">
              {s.before && <span class="text-dim group-hover:text-strong transition-colors">{s.label}</span>}
              <span class="text-strong font-bold text-[20px] tabular-nums">{s.n}</span>
              {!s.before && <span class="text-dim group-hover:text-strong transition-colors">{s.label}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {latest && (
    <section class="band" aria-labelledby="latest">
      <div class="max-w-3xl">
        <span class="eyebrow">Latest · {formatDate(latest.data.pubDate, "medium")} · {getReadingTime(latest.body ?? "")}</span>
        <h2 id="latest" class="text-[22px] lg:text-[26px] font-bold leading-[1.3] tracking-tight mb-4 text-balance">
          <a href={`/blog/${latest.id}/`} class="hover:underline decoration-border-strong underline-offset-[6px] decoration-1">{latest.data.title}</a>
        </h2>
        <p class="lede mb-5">{latest.data.description}</p>
        <a href={`/blog/${latest.id}/`} class="btn !text-[14px]">Read the post →</a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="band" aria-labelledby="more">
      <div class="band-head">
        <h2 id="more" class="h-section">More writing</h2>
        <a href="/blog/" class="nav-link text-[14px]">All {posts.length} posts →</a>
      </div>
      <div class="cells md:grid-cols-3 !gap-x-12">
        {rest.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  <section class="band !pb-20" aria-labelledby="explore">
    <div class="band-head">
      <h2 id="explore" class="h-section">Also here</h2>
    </div>
    <div class="cells md:grid-cols-3 !gap-x-12">
      {explore.map((e) => (
        <a href={e.href} class="group block">
          <span class="row-title block group-hover:decoration-border-strong">{e.title} →</span>
          <span class="block text-[14px] text-dim leading-relaxed mt-2">{e.body}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
