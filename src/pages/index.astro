---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_TAGLINE, formatDate, yearOf } from "../consts";
import { getReadingTime } from "../lib/reading-time";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const cves = await getCollection("cves", ({ data }) => !data.draft);
const certs = await getCollection("certifications");
const [latest, ...rest] = posts;
const firstYear = Math.min(...[...posts, ...cves].map((e) => yearOf(e.data.pubDate)));

const stats = [
  { n: posts.length, label: "posts published", href: "/blog/" },
  { n: cves.length, label: "CVEs disclosed", href: "/cves/" },
  { n: certs.length, label: "certifications", href: "/certifications/" },
  { n: firstYear, label: "writing since", href: "/about/" },
];

const explore = [
  { href: "/cves/", title: "CVEs", body: `${cves.length} vulnerabilities I've found and responsibly disclosed, with severity and CVSS.`, cta: "Browse the table" },
  { href: "/certifications/", title: "Certifications", body: `${certs.length} credentials across web, cloud, and DevSecOps — with verification links.`, cta: "See credentials" },
  { href: "/about/", title: "About", body: "Who I am, what I work on during the day, and what I hunt at night.", cta: "Read more" },
];
---

<BaseLayout>
  <section class="band">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end">
      <div class="lg:col-span-7">
        <span class="eyebrow">Nithissh · security researcher</span>
        <h1 class="h-page mb-6">Security research, written down.</h1>
        <p class="lede mb-8">{SITE_TAGLINE}</p>
        <div class="flex flex-wrap gap-3">
          <a href="/blog/" class="btn">Read the blog →</a>
          <a href="/about/" class="btn btn-ghost">About me</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="cells grid-cols-2">
          {stats.map((s) => (
            <a href={s.href} class="p-5 lg:p-6">
              <span class="stat-num">{s.n}</span>
              <span class="stat-label">{s.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {latest && (
    <section class="band" aria-labelledby="latest">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-16">
        <div class="lg:col-span-8">
          <span class="eyebrow">Latest post · {formatDate(latest.data.pubDate, "medium")}</span>
          <h2 id="latest" class="text-[22px] lg:text-[26px] font-bold leading-[1.3] tracking-tight mb-4 text-balance">
            <a href={`/blog/${latest.id}/`} class="hover:underline decoration-border-strong underline-offset-[6px] decoration-1">{latest.data.title}</a>
          </h2>
          <p class="lede mb-6">{latest.data.description}</p>
          <a href={`/blog/${latest.id}/`} class="link text-[14px]">Read the post →</a>
        </div>
        <dl class="lg:col-span-4 text-[14px] lg:border-l lg:border-border lg:pl-10 space-y-4 self-center">
          <div>
            <dt class="text-dim text-[13px]">Reading time</dt>
            <dd class="text-strong">{getReadingTime(latest.body ?? "")}</dd>
          </div>
          <div>
            <dt class="text-dim text-[13px] mb-1.5">Topics</dt>
            <dd class="flex flex-wrap gap-1.5">
              {latest.data.tags.map((tag) => <a href={`/tags/${tag}/`} class="tag">{tag}</a>)}
            </dd>
          </div>
        </dl>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="band" aria-labelledby="more">
      <div class="band-head">
        <h2 id="more" class="h-section">More writing</h2>
        <a href="/blog/" class="nav-link text-[14px]">All {posts.length} posts →</a>
      </div>
      <div class="cells md:grid-cols-3">
        {rest.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  <section class="band" aria-labelledby="explore">
    <div class="band-head">
      <h2 id="explore" class="h-section">Also on this site</h2>
    </div>
    <div class="cells md:grid-cols-3">
      {explore.map((e) => (
        <a href={e.href} class="flex flex-col p-6 lg:p-7">
          <span class="text-strong font-bold">{e.title}</span>
          <span class="text-[14px] text-dim leading-relaxed mt-2 mb-6">{e.body}</span>
          <span class="text-[14px] text-strong mt-auto">{e.cta} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
