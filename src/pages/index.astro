---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { SITE_TAGLINE, SOCIAL_LINKS, formatDate } from "../consts";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const cves = (await getCollection("cves", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.cvssScore ?? 0) - (a.data.cvssScore ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <section class="mb-16 sm:mb-20">
    <h1 class="text-[22px] font-bold leading-snug mb-4">Hi, I'm Nithissh.</h1>
    <p class="max-w-[60ch]">{SITE_TAGLINE}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-1 mt-5 text-[14px]">
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="link"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-16 sm:mb-20" aria-labelledby="writing">
    <h2 id="writing" class="section-title">Writing</h2>
    {posts.length > 0 ? <PostList posts={posts} /> : <p>Nothing here yet.</p>}
  </section>

  {cves.length > 0 && (
    <section aria-labelledby="disclosures">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 id="disclosures" class="section-title !mb-0">Disclosures</h2>
        <a href="/cves" class="nav-link text-[14px]">all {cves.length} →</a>
      </div>
      <ul class="-my-3">
        {cves.slice(0, 3).map((cve) => (
          <li>
            <a href={`/cves/${cve.id}/`} class="entry">
              <div class="min-w-0">
                <p class="entry-title">{cve.data.title}</p>
                <p class="entry-desc">
                  {cve.data.cveId} · {cve.data.severity.toLowerCase()}
                  {cve.data.cvssScore !== undefined && ` ${cve.data.cvssScore.toFixed(1)}`}
                </p>
              </div>
              <time class="entry-date" datetime={cve.data.pubDate.toISOString()}>{formatDate(cve.data.pubDate, "medium")}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
