---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostTable from "../../components/PostTable.astro";
import Pagination from "../../components/Pagination.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const tagCounts = new Map<string, number>();
  for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  return paginate(posts, { pageSize: 5, props: { tags, total: posts.length } });
}) satisfies GetStaticPaths;

const { page, tags, total } = Astro.props;
---

<BaseLayout
  title={page.currentPage > 1 ? `Blog — page ${page.currentPage}` : "Blog"}
  description="Write-ups on vulnerability research, CVE teardowns, bug bounty findings, and security challenges."
>
  <section class="band">
    <span class="eyebrow">Blog · {total} posts</span>
    <h1 class="h-page mb-5">Writing</h1>
    <p class="lede mb-8">
      Write-ups on vulnerability research, CVE teardowns, bug bounty findings, and security challenges — newest first.
    </p>
    <div class="flex flex-wrap gap-2" aria-label="Topics">
      {tags.map(([tag, n]) => (
        <a href={`/tags/${tag}/`} class="tag !text-[13px] !px-2 !py-0.5">{tag} <span class="opacity-60">{n}</span></a>
      ))}
    </div>
  </section>

  <section class="band !pt-6 lg:!pt-8">
    <PostTable posts={page.data} />
    <div class="mt-10">
      <Pagination current={page.currentPage} last={page.lastPage} prev={page.url.prev} next={page.url.next} base="/blog" />
    </div>
  </section>
</BaseLayout>
