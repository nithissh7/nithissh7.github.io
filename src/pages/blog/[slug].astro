---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getReadingTime } from "../../lib/reading-time";
import { SITE_AUTHOR, formatDate, tagColor } from "../../consts";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const readTime = getReadingTime(post.body ?? "");
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const author = post.data.author ?? SITE_AUTHOR;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { "@type": "Person", name: author },
  publisher: { "@type": "Person", name: SITE_AUTHOR },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).toString(),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(", ") }),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  image={`/blog/${post.id}/og.png`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <div class="band">
      <div class="max-w-[72ch] mx-auto">
        <header class="mb-10">
          <nav aria-label="Breadcrumb" class="text-[13px] text-dim mb-6" data-pagefind-ignore>
            <a href="/blog/" class="nav-link">← All posts</a>
          </nav>
          <div class="page-icon" aria-hidden="true">📄</div>
          <h1 class="text-[26px] lg:text-[32px] font-bold leading-[1.25] tracking-tight text-strong text-balance mb-4">
            {post.data.title}
          </h1>
          <p class="text-[16px] leading-[1.75] mb-5">{post.data.description}</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-dim" data-pagefind-ignore>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, "medium")}</time>
            <span aria-hidden="true">·</span>
            <span>{readTime}</span>
            {post.data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>updated {formatDate(post.data.updatedDate, "medium")}</span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{author}</span>
          </div>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3" data-pagefind-ignore>
              {post.data.tags.map((tag) => <a href={`/tags/${tag}/`} class="tag" data-color={tagColor(tag)}>{tag}</a>)}
            </div>
          )}
        </header>

        {toc.length > 2 && (
          <details class="toc-box mb-10" data-pagefind-ignore>
            <summary class="flex items-center gap-3 cursor-pointer select-none py-1 text-[14px] text-strong">
              <span>Contents <span class="text-dim">· {toc.filter((h) => h.depth === 2).length} sections</span></span>
              <span class="toc-chevron text-dim" aria-hidden="true">+</span>
            </summary>
            <nav class="toc pt-3" aria-label="Contents">
              {toc.map((h) => <a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a>)}
            </nav>
          </details>
        )}

        <div class="prose" data-pagefind-body data-pagefind-meta={`title:${post.data.title}`}>
          <Content />
        </div>
      </div>
    </div>

    <footer class="band" data-pagefind-ignore>
      <div class="max-w-[72ch] mx-auto">
      <p class="text-[14px] text-dim mb-8">
        Thanks for reading. Questions, corrections, or a bug you want to talk about?
        <a href="mailto:realnits@gmail.com" class="link">Email me</a>.
      </p>
      {(newer || older) && (
        <nav aria-label="More posts" class="grid md:grid-cols-2 gap-8 pt-8 border-t border-border">
          {older ? (
            <a href={`/blog/${older.id}/`} class="group block">
              <span class="block text-[13px] text-dim mb-2">← Previous post</span>
              <span class="row-title block leading-snug group-hover:decoration-border-strong">{older.data.title}</span>
            </a>
          ) : <div class="hidden md:block" />}
          {newer ? (
            <a href={`/blog/${newer.id}/`} class="group block md:text-right">
              <span class="block text-[13px] text-dim mb-2">Next post →</span>
              <span class="row-title block leading-snug group-hover:decoration-border-strong">{newer.data.title}</span>
            </a>
          ) : <div class="hidden md:block" />}
        </nav>
      )}
      </div>
    </footer>
  </article>
</BaseLayout>
