---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tagLabel } from "../../consts";
import { getPosts, tagCounts } from "../../lib/posts";

const posts = await getPosts();
const tags = tagCounts(posts);
---

<BaseLayout title="Topics" description="Every topic written about on realnits.">
  <div class="shell">
    <header class="page-head">
      <nav aria-label="Breadcrumb" class="eyebrow">
        <a href="/blog/">Writing</a>
        <span class="sep">/</span>
        <span>Topics</span>
      </nav>
      <h1 class="h-page">Topics</h1>
      <p class="lede mt-5">{tags.length} topics across {posts.length} posts. Pick one to see its posts.</p>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-12 border-t border-border-strong" aria-label="Topics">
      {tags.map(([tag, n]) => (
        <li>
          <a href={`/tags/${tag}/`} class="topic-row">
            <span>{tagLabel(tag)}</span>
            <span class="n">{n} {n === 1 ? "post" : "posts"}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
