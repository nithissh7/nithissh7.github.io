---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Topics written about on realnits.">
  <section class="band">
    <nav aria-label="Breadcrumb" class="text-[13px] text-dim mb-8">
      <a href="/blog/" class="nav-link">Blog</a><span class="mx-2" aria-hidden="true">/</span><span>Tags</span>
    </nav>
    <h1 class="h-page mb-5">Topics</h1>
    <p class="lede">Every tag used across {posts.length} posts.</p>
  </section>
  <section class="band">
    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-10 gap-y-3">
      {tags.map(([tag, n]) => (
        <li class="contents">
          <a href={`/tags/${tag}/`} class="group flex items-baseline gap-2">
            <span class="row-title truncate group-hover:decoration-border-strong">#{tag}</span>
            <span class="text-[13px] text-dim tabular-nums">{n}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
