---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostTable from "../../components/PostTable.astro";
import { tagColor } from "../../consts";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Posts tagged ${tag}`} description={`Posts tagged ${tag}.`}>
  <section class="band">
    <nav aria-label="Breadcrumb" class="text-[13px] text-dim mb-8">
      <a href="/tags/" class="nav-link">Tags</a><span class="mx-2" aria-hidden="true">/</span><span>{tag}</span>
    </nav>
    <div class="page-icon" aria-hidden="true">🏷️</div>
    <h1 class="mb-5"><span class="tag !text-[28px] lg:!text-[34px] !leading-[1.35] !px-3 font-bold" data-color={tagColor(tag)}>{tag}</span></h1>
    <p class="lede">{posts.length} {posts.length === 1 ? "post" : "posts"} on this topic.</p>
  </section>
  <section class="band !pt-2">
    <PostTable posts={posts} />
  </section>
</BaseLayout>
