---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="band min-h-[55vh] flex flex-col justify-center">
    <div class="page-icon" aria-hidden="true">🧭</div>
    <span class="eyebrow">404</span>
    <h1 class="h-page mb-5">This page doesn't exist.</h1>
    <p class="lede mb-8">It may have moved, or the link might be wrong.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn">Go home</a>
      <a href="/search/" class="btn btn-ghost">Search the site</a>
    </div>
  </section>
</BaseLayout>
