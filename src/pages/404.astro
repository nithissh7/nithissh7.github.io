---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <div class="border-brutal shadow-brutal-sm bg-paper p-8 sm:p-12 text-center">
    <p class="text-sm font-medium text-accent-ink mb-2">404</p>
    <h1 class="text-2xl sm:text-3xl font-bold mb-3">Page not found</h1>
    <p class="text-ink-soft mb-6">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a
      href="/"
      class="inline-block border-brutal shadow-brutal-sm brutal-press bg-accent text-accent-ink px-4 py-2 font-medium text-sm"
    >
      &larr; Back home
    </a>
  </div>
</BaseLayout>
