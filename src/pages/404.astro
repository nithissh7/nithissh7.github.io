---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
const featured = posts.filter((p) => p.data.featured);
const suggestions = (featured.length > 0 ? featured : posts).slice(0, 3);
---

<BaseLayout title="Page not found">
  <div class="shell shell-reading">
    <header class="page-head">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-page">This page <em>doesn't exist.</em></h1>
      <p class="lede mt-5">It may have moved, or the link might be wrong.</p>
      <div class="flex flex-wrap gap-2.5 mt-7">
        <a href="/" class="btn">Go home</a>
        <a href="/search/" class="btn btn-ghost">Search the site</a>
      </div>
    </header>

    {suggestions.length > 0 && (
      <section aria-labelledby="worth-reading">
        <div class="section-head">
          <h2 id="worth-reading" class="h-section">Worth reading instead</h2>
          <a href="/blog/" class="more-link">Archive →</a>
        </div>
        <EntryList posts={suggestions} compact />
      </section>
    )}
  </div>
</BaseLayout>
