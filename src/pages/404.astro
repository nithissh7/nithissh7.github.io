---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="hero band min-h-[60vh] flex flex-col justify-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="h-page mb-5">This page <em>doesn't exist.</em></h1>
    <p class="lede mb-8">It may have moved, or the link might be wrong.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn">Go home <span aria-hidden="true">▸</span></a>
      <a href="/search/" class="btn btn-ghost">Search the site</a>
    </div>
  </section>
</BaseLayout>
