---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="py-10 sm:py-16 text-[14px]">
    <p class="text-muted">$ cd <span id="missing-path">this-page</span></p>
    <p class="text-ink mt-1 mb-8">cd: no such file or directory</p>
    <h1 class="text-[22px] font-bold mb-3">404 — nothing here</h1>
    <p class="font-serif text-[17px] text-ink-2 mb-8 max-w-md">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px]">
      <a href="/" class="btn-bracket">home</a>
      <a href="/search" class="btn-bracket">search</a>
    </div>
  </div>
  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      const el = document.getElementById("missing-path");
      if (el) el.textContent = location.pathname;
    });
  </script>
</BaseLayout>
