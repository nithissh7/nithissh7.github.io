---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";
import { ClientRouter } from "astro:transitions";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  image?: string;
  /** Article pages: header, content and footer share one ~848px reading column. */
  reading?: boolean;
}

const { title, description = SITE_DESCRIPTION, type = "website", pubDate, image = "/og.png", reading = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · security research, written down`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          if (theme !== "light" && theme !== "dark") {
            theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />
    <title>{pageTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImageURL} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />
  </head>
  <body>
    <div class="read-progress" data-progress hidden></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-strong focus:text-bg focus:px-3 focus:py-1.5 focus:rounded"
    >
      Skip to content
    </a>
    <div class:list={["wrap frame min-h-screen flex flex-col", { "wrap-reading": reading }]}>
      <Header />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    {!Astro.url.pathname.startsWith("/search") && (
      <dialog
        id="search-dialog"
        aria-label="Search"
        class="search-dialog m-0 p-0 w-[min(40rem,calc(100vw-2rem))] mx-auto mt-[10vh] bg-bg text-text border border-border-strong rounded-xl overflow-hidden"
      >
        <Search mode="dialog" />
        <div class="flex items-center justify-between gap-4 px-4 py-2.5 border-t border-border text-[12px] text-dim">
          <span><span class="kbd">esc</span> to close</span>
          <a href="/search/" class="nav-link">Open search page →</a>
        </div>
      </dialog>
    )}
    <dialog id="lightbox" class="lightbox" aria-label="Image preview">
      <img alt="" />
      <p></p>
    </dialog>
    <button type="button" class="to-top" data-to-top aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>
    <p id="announcer" class="sr-only" aria-live="polite"></p>

    <script>
      import { navigate } from "astro:transitions/client";

      // Delegated handlers survive ClientRouter page swaps.
      document.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;

        const copyText = target.closest<HTMLButtonElement>("[data-copy-text]");
        if (copyText) {
          const label = copyText.dataset.label ?? (copyText.dataset.label = copyText.textContent ?? "copy");
          try {
            await navigator.clipboard.writeText(copyText.dataset.copyText ?? "");
            copyText.textContent = "copied ✓";
          } catch {
            copyText.textContent = "failed";
          }
          setTimeout(() => (copyText.textContent = label), 1500);
          return;
        }

        const copyBtn = target.closest<HTMLButtonElement>("[data-copy]");
        if (copyBtn) {
          const code = copyBtn.closest(".code-block")?.querySelector("pre")?.innerText ?? "";
          try {
            await navigator.clipboard.writeText(code.replace(/\n$/, ""));
            copyBtn.textContent = "copied ✓";
            const announcer = document.getElementById("announcer");
            if (announcer) announcer.textContent = "Code copied to clipboard";
          } catch {
            copyBtn.textContent = "failed";
          }
          setTimeout(() => (copyBtn.textContent = "copy"), 1500);
          return;
        }

        const zoomable = target.closest<HTMLImageElement>(".prose img");
        if (zoomable && !target.closest("a")) {
          const box = document.getElementById("lightbox") as HTMLDialogElement | null;
          if (box) {
            const img = box.querySelector("img")!;
            img.src = zoomable.currentSrc || zoomable.src;
            img.alt = zoomable.alt;
            box.querySelector("p")!.textContent = zoomable.alt;
            box.showModal();
          }
          return;
        }
        if (target.closest("#lightbox")) {
          (document.getElementById("lightbox") as HTMLDialogElement).close();
          return;
        }

        if (target.closest("[data-to-top]")) {
          window.scrollTo({ top: 0 });
          return;
        }

        if (target.closest("[data-search-open]")) {
          if (!openSearch()) navigate("/search/");
          return;
        }

        const dialog = target.closest("dialog");
        if (dialog && target === dialog) {
          (dialog as HTMLDialogElement).close(); // click on the backdrop
          return;
        }

        if (target.closest("[data-theme-toggle]")) {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
        }
      });

      function openSearch(): boolean {
        const pageInput = document.getElementById("search-input") as HTMLInputElement | null;
        if (pageInput) {
          pageInput.focus();
          return true;
        }
        const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
        if (!dialog) return false;
        if (!dialog.open) dialog.showModal();
        dialog.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
        return true;
      }
      document.addEventListener("astro:before-swap", () => {
        (document.getElementById("search-dialog") as HTMLDialogElement | null)?.close();
        (document.getElementById("lightbox") as HTMLDialogElement | null)?.close();
      });

      // ⌘K / Ctrl+K / "/" open search from anywhere.
      document.addEventListener("keydown", (event) => {
        const el = event.target instanceof Element ? event.target : null;
        const typing = el?.closest("input, textarea, [contenteditable]");
        const combo = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
        if (combo || (event.key === "/" && !typing)) {
          event.preventDefault();
          if (!openSearch()) navigate("/search/");
        }
      });

      function enhancePost() {
        const prose = document.querySelector(".prose");
        if (!prose) return;

        prose.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]").forEach((heading) => {
          if (heading.querySelector(".anchor")) return;
          const anchor = document.createElement("a");
          anchor.href = `#${heading.id}`;
          anchor.className = "anchor";
          anchor.setAttribute("aria-label", "Link to this section");
          anchor.textContent = "#";
          heading.append(anchor);
        });

        // A paragraph holding only an image becomes a figure captioned with its alt text.
        prose.querySelectorAll<HTMLImageElement>("p > img").forEach((img) => {
          const p = img.parentElement!;
          if (p.childElementCount !== 1 || p.textContent!.trim()) return;
          const figure = document.createElement("figure");
          figure.append(img);
          if (img.alt) {
            const caption = document.createElement("figcaption");
            caption.textContent = img.alt;
            figure.append(caption);
          }
          p.replaceWith(figure);
        });

        const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
        tocTargets = links
          .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
          .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => !!t.el);
        updateToc();
      }

      // Highlight the section being read: the last heading scrolled past the header.
      let tocTargets: { a: HTMLAnchorElement; el: HTMLElement }[] = [];
      function updateToc() {
        if (!tocTargets.length) return;
        let current = tocTargets[0];
        for (const t of tocTargets) if (t.el.getBoundingClientRect().top < 120) current = t;
        tocTargets.forEach((t) => t.a.setAttribute("aria-current", String(t.el === current.el)));
      }
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateToc();
            ticking = false;
          });
        },
        { passive: true }
      );

      // Mermaid renders client-side (and re-renders on theme change), so size every
      // SVG it inserts: never below MIN_SCALE of natural size; scroll sideways instead.
      const MIN_SCALE = 0.72;
      function sizeDiagram(pre: HTMLElement) {
        const svg = pre.querySelector("svg");
        if (!svg || svg.dataset.sized) return;
        svg.dataset.sized = "true";

        let wrap = pre.closest<HTMLElement>(".diagram");
        if (!wrap) {
          wrap = document.createElement("figure");
          wrap.className = "diagram";
          const bar = document.createElement("div");
          bar.className = "diagram-bar";
          bar.innerHTML = `<span></span><button type="button" data-diagram-open>open full size ↗</button>`;
          pre.replaceWith(wrap);
          wrap.append(bar, pre);
        }

        const natural = svg.viewBox.baseVal?.width || svg.getBoundingClientRect().width;
        const pad = 32;
        const available = pre.clientWidth - pad;
        const width = Math.min(natural, Math.max(available, natural * MIN_SCALE));
        // astro-mermaid forces width:100% !important; an inline !important wins.
        svg.style.setProperty("max-width", "none", "important");
        svg.style.setProperty("width", `${Math.round(width)}px`, "important");
        svg.style.setProperty("height", "auto", "important");

        const overflows = pre.scrollWidth > pre.clientWidth + 1;
        wrap.querySelector(".diagram-bar span")!.textContent = overflows ? "diagram · scroll →" : "diagram";
      }
      function watchDiagrams() {
        document.querySelectorAll<HTMLElement>(".prose .mermaid").forEach((pre) => {
          if (pre.dataset.watched) return;
          pre.dataset.watched = "true";
          sizeDiagram(pre);
          new MutationObserver(() => sizeDiagram(pre)).observe(pre, { childList: true, subtree: true });
        });
      }
      document.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement).closest("[data-diagram-open]");
        const svg = btn?.closest(".diagram")?.querySelector("svg");
        if (!svg) return;
        const clone = svg.cloneNode(true) as SVGSVGElement;
        // Open fitted to the screen (pinch/zoom to read details), never larger than natural size.
        clone.setAttribute("style", `width:100%;height:auto;max-width:${svg.viewBox.baseVal.width}px;display:block;margin:0 auto`);
        const styles = getComputedStyle(document.documentElement);
        const bg = styles.getPropertyValue("--bg").trim();
        const doc = `<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Diagram</title><body style="margin:0;padding:16px;background:${bg}">${clone.outerHTML}</body>`;
        window.open(URL.createObjectURL(new Blob([doc], { type: "text/html" })), "_blank", "noopener");
      });

      // The header gets its hairline only once the page scrolls under it; on articles a
      // progress bar tracks how far through the text the reader is.
      const markHeader = () => {
        document.querySelector(".site-header")?.toggleAttribute("data-scrolled", window.scrollY > 8);
        document.querySelector("[data-to-top]")?.toggleAttribute("data-visible", window.scrollY > 900);
        const bar = document.querySelector<HTMLElement>("[data-progress]");
        const body = document.querySelector<HTMLElement>("[data-reading-body]");
        if (!bar) return;
        bar.hidden = !body;
        if (!body) return;
        const rect = body.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const done = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
        bar.style.transform = `scaleX(${done})`;
      };
      window.addEventListener("scroll", markHeader, { passive: true });

      document.addEventListener("astro:page-load", () => {
        markHeader();
        enhancePost();
        watchDiagrams();
      });
    </script>
  </body>
</html>
