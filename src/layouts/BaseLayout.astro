---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";
import { ClientRouter } from "astro:transitions";
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
// Body (400) and title (700) faces are on every first paint; preload them so text isn't held back.
import monoRegular from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import monoBold from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, type = "website", pubDate, image = "/og.png" } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · security research, written down`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          if (theme !== "light" && theme !== "dark") {
            theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.dataset.theme = theme;
          // Reader settings (text size, column width) chosen from the "Aa" menu.
          try {
            const size = localStorage.getItem("reader:size");
            const measure = localStorage.getItem("reader:measure");
            if (size) document.documentElement.dataset.textSize = size;
            if (measure) document.documentElement.dataset.measure = measure;
          } catch {}
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <link rel="preload" href={monoRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoBold} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />
    <title>{pageTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImageURL} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    {!Astro.url.pathname.startsWith("/search") && (
      <dialog id="search-dialog" aria-label="Search" class="search-dialog">
        <Search mode="dialog" />
        <div class="flex items-center justify-between gap-4 px-4 py-2.5 border-t border-border text-[12px] text-dim">
          <span><span class="kbd">esc</span> to close</span>
          <a href="/search/" class="nav-link">Open search page →</a>
        </div>
      </dialog>
    )}
    <dialog id="lightbox" class="lightbox" aria-label="Image preview">
      <img alt="" />
      <p></p>
    </dialog>
    <button type="button" class="to-top" data-to-top aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>
    <dialog id="diagram-viewer" class="diagram-viewer" aria-label="Diagram viewer">
      <div class="dv-bar">
        <span class="dv-hint">drag to pan · scroll or +/− to zoom</span>
        <div class="dv-actions">
          <button type="button" data-dv="out" aria-label="Zoom out">−</button>
          <button type="button" data-dv="fit">fit</button>
          <button type="button" data-dv="in" aria-label="Zoom in">+</button>
          <button type="button" data-dv="close" aria-label="Close (Esc)">esc</button>
        </div>
      </div>
      <div class="dv-stage" data-dv-stage></div>
    </dialog>
    <dialog id="shortcuts" class="shortcuts" aria-label="Keyboard shortcuts">
      <p class="text-strong font-bold mb-4">Keyboard shortcuts</p>
      <dl>
        <div><dt><span class="kbd">/</span> <span class="kbd">⌘K</span></dt><dd>search</dd></div>
        <div><dt><span class="kbd">j</span> <span class="kbd">k</span></dt><dd>next / previous section</dd></div>
        <div><dt><span class="kbd">←</span> <span class="kbd">→</span></dt><dd>older / newer post</dd></div>
        <div><dt><span class="kbd">t</span></dt><dd>toggle light / dark</dd></div>
        <div><dt><span class="kbd">g</span> <span class="kbd">g</span></dt><dd>back to top</dd></div>
        <div><dt><span class="kbd">?</span></dt><dd>this help</dd></div>
      </dl>
      <p class="text-[13.5px] text-dim mt-4">On a post, select any passage to copy a link to it.</p>
      <form method="dialog" class="mt-4 text-right"><button class="nav-link cursor-pointer text-[12.5px]">close <span class="kbd">esc</span></button></form>
    </dialog>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <p id="announcer" class="sr-only" aria-live="polite"></p>

    <script>
      import "../scripts/site";
      import "../scripts/reader";
      import "../scripts/diagrams";
    </script>
  </body>
</html>
