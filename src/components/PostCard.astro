---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../consts";
import { getReadingTime } from "../lib/reading-time";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article class="flex flex-col">
  <span class="text-[13px] text-dim tabular-nums">
    {formatDate(post.data.pubDate, "medium")} · {getReadingTime(post.body ?? "").replace(" read", "")}
  </span>
  <a href={`/blog/${post.id}/`} class="group mt-2">
    <span class="row-title block text-[16px] leading-snug group-hover:decoration-border-strong">{post.data.title}</span>
  </a>
  <p class="text-[14px] text-dim leading-relaxed mt-2 line-clamp-3">{post.data.description}</p>
  <span class="flex flex-wrap gap-x-3 mt-3">
    {post.data.tags.slice(0, 3).map((tag) => <a href={`/tags/${tag}/`} class="tag">{tag}</a>)}
  </span>
</article>
