---
import { getReadingTime } from "../lib/reading-time";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  body: string;
}

const { slug, title, description, pubDate, tags, body } = Astro.props;
const readTime = getReadingTime(body);

const accents = [
  { bg: "bg-accent", ink: "text-accent-ink" },
  { bg: "bg-accent-2", ink: "text-accent-2-ink" },
  { bg: "bg-accent-pink", ink: "text-accent-pink-ink" },
];
const accent = accents[Math.abs(title.length) % accents.length];
---

<a
  href={`/blog/${slug}/`}
  class="block border-brutal shadow-brutal-sm brutal-press bg-paper p-5 sm:p-6"
>
  <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
    <time datetime={pubDate.toISOString()} class="text-xs font-medium text-ink-soft">
      {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
    </time>
    <span class={`text-xs font-medium rounded-full px-2.5 py-0.5 ${accent.bg} ${accent.ink}`}>
      {readTime}
    </span>
  </div>
  <h2 class="text-xl sm:text-2xl font-bold mb-2 leading-tight">{title}</h2>
  <p class="text-sm sm:text-base text-ink-soft mb-4">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs font-medium text-ink-soft border border-line rounded-full px-2.5 py-0.5">
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>
