---
interface Props {
  current: number;
  last: number;
  prev?: string;
  next?: string;
  base: string; // e.g. "/blog"
}

const { current, last, prev, next, base } = Astro.props;
const href = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}/`);
---

{last > 1 && (
  <nav aria-label="Pagination" class="flex items-center justify-between gap-4 text-[14px]">
    {prev ? <a href={prev} class="nav-link">← Newer</a> : <span class="text-dim opacity-40" aria-hidden="true">← Newer</span>}
    <ol class="flex items-center gap-4">
      {Array.from({ length: last }, (_, i) => i + 1).map((n) => (
        <li>
          <a
            href={href(n)}
            aria-current={n === current ? "page" : undefined}
            class={`tabular-nums ${n === current ? "text-strong font-bold underline underline-offset-[6px] decoration-1" : "nav-link"}`}
          >
            {n}
          </a>
        </li>
      ))}
    </ol>
    {next ? <a href={next} class="nav-link">Older →</a> : <span class="text-dim opacity-40" aria-hidden="true">Older →</span>}
  </nav>
)}
