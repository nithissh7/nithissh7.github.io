---
import { SITE_AUTHOR, SITE_TITLE, SOCIAL_LINKS } from "../consts";
const year = new Date().getFullYear();

const columns = [
  {
    label: "Read",
    links: [
      { href: "/blog/", label: "Blog" },
      { href: "/cves/", label: "CVEs" },
      { href: "/tags/", label: "Topics" },
      { href: "/search/", label: "Search" },
    ],
  },
  {
    label: "About",
    links: [
      { href: "/about/", label: "About me" },
      { href: "/certifications/", label: "Certifications" },
    ],
  },
  { label: "Elsewhere", links: SOCIAL_LINKS },
];
const external = (href: string) => href.startsWith("http");
---

<footer class="border-t border-border mx-4 sm:mx-8 lg:mx-12 mt-8">
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))] py-14">
    <div>
      <a href="/" class="wordmark mb-4">
        <span class="logo-mark" aria-hidden="true">rn</span>
        <span>{SITE_TITLE}</span>
      </a>
      <p class="text-[14px] text-dim max-w-[36ch] leading-relaxed">
        Security research, written down. Web, cloud, and whatever breaks next.
      </p>
      <p class="text-[13px] text-dim mt-4">Set in JetBrains Mono. No trackers.</p>
    </div>
    {columns.map((col) => (
      <div>
        <p class="eyebrow !mb-4">{col.label}</p>
        <ul class="space-y-2 text-[14px]">
          {col.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                target={external(link.href) ? "_blank" : undefined}
                rel={external(link.href) ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="py-6 border-t border-border flex flex-wrap justify-between gap-4 text-[12px] tracking-[0.07em] uppercase text-dim">
    <span>© {year} {SITE_AUTHOR}</span>
    <a href="#main-content" class="nav-link">Back to top ↑</a>
  </div>
</footer>
