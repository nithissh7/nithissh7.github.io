---
import { SITE_AUTHOR, SITE_TITLE, SOCIAL_LINKS } from "../consts";
const year = new Date().getFullYear();

const links = [
  { href: "/blog/", label: "Writing" },
  { href: "/cves/", label: "CVEs" },
  { href: "/tags/", label: "Topics" },
  { href: "/certifications/", label: "Certifications" },
  { href: "/about/", label: "About" },
  ...SOCIAL_LINKS,
];
const external = (href: string) => href.startsWith("http");
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <p class="footer-note">
        <a href="/" class="wordmark">
          <span class="logo-mark" aria-hidden="true">rn</span>
          <span>{SITE_TITLE}</span>
        </a>
        <span>Security research, written down.</span>
      </p>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                target={external(link.href) ? "_blank" : undefined}
                rel={external(link.href) ? "noopener noreferrer me" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE_AUTHOR} · No trackers</span>
      <span class="hidden md:inline">Press <span class="kbd">?</span> for keyboard shortcuts</span>
      <a href="#main-content" class="nav-link">Back to top ↑</a>
    </div>
  </div>
</footer>
