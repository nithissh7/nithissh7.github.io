---
import { NAV_LINKS, SITE_TITLE } from "../consts";

const path = Astro.url.pathname;
// Topic pages belong to Writing; certifications to About.
const sections: Record<string, string[]> = {
  "/blog/": ["/blog/", "/tags/"],
  "/about/": ["/about/", "/certifications/"],
};
const isActive = (href: string) => (sections[href] ?? [href]).some((prefix) => path.startsWith(prefix));
---

<header class="site-header">
  <div class="shell site-header-row">
    <a href="/" class="wordmark">
      <span class="logo-mark" aria-hidden="true">rn</span>
      <span class="wordmark-text">{SITE_TITLE}</span>
      <span class="sr-only">home</span>
    </a>

    <nav aria-label="Main" class="main-nav">
      {NAV_LINKS.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="site-tools">
      <button type="button" data-search-open class="search-btn" aria-keyshortcuts="Meta+K Control+K">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="search-btn-label">Search</span>
        <span class="kbd" aria-hidden="true">⌘K</span>
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>
      <a href="/rss.xml" class="icon-btn hidden sm:inline-grid" aria-label="RSS feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>
