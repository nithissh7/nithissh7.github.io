---
import { SITE_TITLE } from "../consts";

const navLinks = [
  { href: "/", label: "home" },
  { href: "/tags", label: "tags" },
  { href: "/cves", label: "cves" },
  { href: "/certifications", label: "certs" },
  { href: "/about", label: "about" },
  { href: "/search", label: "search" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" || currentPath.startsWith("/blog") : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-6">
    <a href="/" class="font-bold text-[15px] tracking-tight text-ink shrink-0" aria-label={`${SITE_TITLE}, home`}>
      {SITE_TITLE}<span class="cursor" aria-hidden="true"></span>
    </a>

    <div class="flex items-center gap-5">
      <nav aria-label="Main" class="hidden sm:flex items-center gap-5 text-[13px]">
        {navLinks.map((link) => (
          <a href={link.href} class="quiet" aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <button type="button" class="btn-bracket text-[13px]" data-theme-toggle aria-label="Toggle theme">theme</button>
    </div>
  </div>

  <nav
    aria-label="Main"
    class="sm:hidden flex items-center justify-between px-4 h-10 border-t border-line text-[13px]"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="quiet py-2" aria-current={isActive(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>

  <div id="progress" aria-hidden="true"></div>
</header>

<style>
  a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
  }
</style>
