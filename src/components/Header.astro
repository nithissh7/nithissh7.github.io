---
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";

const navLinks = [
  { href: "/blog/", label: "Blog" },
  { href: "/cves/", label: "CVEs" },
  { href: "/certifications/", label: "Certifications", short: "Certs" },
  { href: "/tags/", label: "Topics" },
  { href: "/about/", label: "About" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const github = SOCIAL_LINKS.find((l) => l.label === "GitHub")?.href;
---

<header class="site-header sticky top-0 z-40 bg-bg/85 backdrop-blur-md">
  <div class="h-[4.5rem] flex items-center gap-4 px-4 sm:px-8 lg:px-12">
    <a href="/" class="wordmark shrink-0" aria-label={`${SITE_TITLE}, home`}>
      <span class="logo-mark" aria-hidden="true">rn</span>
      <span>{SITE_TITLE}<span class="caret" aria-hidden="true"></span></span>
    </a>

    <nav aria-label="Main" class="main-nav hidden md:flex items-center gap-1 ml-6">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button type="button" data-search-open class="search-btn hidden sm:inline-flex">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <span>Search</span>
        <span class="kbd">⌘K</span>
      </button>
      <button type="button" data-search-open class="icon-btn sm:hidden" aria-label="Search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="icon-btn hidden lg:inline-grid" aria-label="GitHub">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
          </svg>
        </a>
      )}
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>
      <a href="/rss.xml" class="btn btn-sm hidden sm:inline-flex">Subscribe <span aria-hidden="true">▸</span></a>
    </div>
  </div>

  <nav aria-label="Main" class="main-nav md:hidden flex items-center gap-1 h-11 px-2 sm:px-6 overflow-x-auto">
    {navLinks.map((link) => (
      <a href={link.href} class="nav-link shrink-0" aria-current={isActive(link.href) ? "page" : undefined}>
        {link.short ?? link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-moon {
    display: block;
  }
</style>
