---
import { SITE_TITLE } from "../consts";

const navLinks = [
  { href: "/blog/", label: "Blog" },
  { href: "/cves/", label: "CVEs" },
  { href: "/certifications/", label: "Certifications", short: "Certs" },
  { href: "/about/", label: "About" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path.startsWith(href) || (href === "/blog/" && path.startsWith("/tags"));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="h-16 flex items-center gap-6 px-5 sm:px-8 lg:px-12">
    <a href="/" class="flex items-center gap-2.5 shrink-0 text-strong font-bold text-[15px]" aria-label={`${SITE_TITLE}, home`}>
      <span class="mark" aria-hidden="true"></span>
      {SITE_TITLE}
    </a>

    <nav aria-label="Main" class="hidden md:flex items-center gap-7 text-[14px] ml-6">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="/search/"
        class="hidden sm:flex items-center gap-3 h-9 w-56 pl-3 pr-2 rounded-md border border-border text-dim text-[13px] hover:border-border-strong hover:text-strong transition-colors"
        aria-label="Search"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="flex-1">Search…</span>
        <span class="kbd">⌘K</span>
      </a>
      <a href="/search/" class="icon-btn sm:hidden" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav aria-label="Main" class="md:hidden flex items-center gap-6 h-11 px-5 sm:px-8 border-t border-border text-[14px] overflow-x-auto">
    {navLinks.map((link) => (
      <a href={link.href} class="nav-link shrink-0" aria-current={isActive(link.href) ? "page" : undefined}>
        {link.short ?? link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .mark {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--strong);
    border-radius: 2px;
  }
  .theme-icon-moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-moon {
    display: block;
  }
</style>
