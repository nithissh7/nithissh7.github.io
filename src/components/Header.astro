---
import { SITE_TITLE } from "../consts";

const navLinks = [
  { href: "/", label: "blog" },
  { href: "/cves", label: "cves" },
  { href: "/certifications", label: "certs" },
  { href: "/about", label: "about" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" || path.startsWith("/blog") || path.startsWith("/tags") : path.startsWith(href);
---

<header class="w-full max-w-[680px] mx-auto px-5 sm:px-6 pt-6 sm:pt-8">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <a href="/" class="font-bold text-strong text-[15px] tracking-tight h-8 flex items-center" aria-label={`${SITE_TITLE}, home`}>
      {SITE_TITLE}
    </a>

    <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto sm:ml-auto flex items-center gap-6 text-[14px]">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 sm:-mr-2">
      <a href="/search" class="icon-btn" aria-label="Search" aria-current={path.startsWith("/search") ? "page" : undefined}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-icon-moon {
    display: block;
  }
</style>
