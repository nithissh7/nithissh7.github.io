---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../consts";
import { getReadingTime } from "../lib/reading-time";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const cols = "md:grid md:grid-cols-[9rem_minmax(0,1fr)_13rem_4.5rem] md:gap-8";
---

<div class="tlist">
  <div class={`table-head hidden ${cols} py-2.5 px-3 -mx-3`} aria-hidden="true">
    <span>Date</span><span>Title</span><span>Tags</span><span class="text-right">Read</span>
  </div>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class={`trow block ${cols} py-5 px-3 -mx-3 rounded-sm`}>
          <span class="block text-[13px] text-dim tabular-nums md:text-[14px] md:pt-px">
            {formatDate(post.data.pubDate, "medium")}
            <span class="md:hidden"> · {getReadingTime(post.body ?? "").replace(" read", "")}</span>
          </span>
          <span class="block min-w-0 mt-1 md:mt-0">
            <span class="row-title block leading-snug">{post.data.title}</span>
            <span class="block text-[14px] text-dim mt-1.5 leading-relaxed line-clamp-2">{post.data.description}</span>
          </span>
          <span class="hidden md:flex flex-wrap content-start gap-x-3 pt-0.5">
            {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
          </span>
          <span class="hidden md:block text-[14px] text-dim text-right tabular-nums">
            {getReadingTime(post.body ?? "").replace(" read", "")}
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
